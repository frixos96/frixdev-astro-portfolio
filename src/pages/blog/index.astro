---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<Layout title="Blog">
  <Header />
  <main class="mx-auto max-w-3xl px-6 py-20">
    <div class="reveal">
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Blog
      </h1>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">
        Thoughts on the web, design, and building things.
      </p>
    </div>

    <ul class="mt-12 flex flex-col divide-y divide-slate-200 dark:divide-slate-800">
      {
        posts.map((post, i) => (
          <li class="reveal" style={`--reveal-delay:${i * 70}ms`}>
            <a
              href={`/blog/${post.id}/`}
              class="group flex flex-col gap-2 py-6 sm:flex-row sm:items-baseline sm:gap-6"
            >
              <time class="shrink-0 font-mono text-sm text-slate-500 dark:text-slate-400">
                {fmt(post.data.pubDate)}
              </time>
              <div>
                <h2 class="text-lg font-semibold text-slate-900 transition group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-400">
                  {post.data.title}
                </h2>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
                  {post.data.description}
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="/"
      class="mt-12 inline-flex items-center gap-2 text-sm font-medium text-brand-600 transition hover:underline dark:text-brand-400"
    >
      ← Back home
    </a>
  </main>
</Layout>
