---
import { Icon } from "astro-icon/components";
import { about, site, skillCategories, techStack } from "../data/portfolio";

// Initials used by the placeholder when no photo is set in portfolio.ts.
const initials = site.name
  .split(" ")
  .map((part) => part[0])
  .slice(0, 2)
  .join("");
---

<section id="about" class="mx-auto max-w-5xl px-6 py-20">
  <div class="reveal flex items-center gap-4">
    <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl dark:text-white">
      <span class="font-mono text-brand-500">01.</span> About
    </h2>
    <span class="h-px flex-1 bg-slate-200 dark:bg-slate-800"></span>
  </div>

  <div class="mt-10 grid gap-10 lg:grid-cols-[1.6fr_1fr] lg:items-start">
    <!-- Bio (left on desktop, second on mobile) -->
    <div class="reveal order-2 space-y-4 lg:order-1">
      {
        about.paragraphs.map((p) => (
          <p class="leading-relaxed text-slate-600 dark:text-slate-400">{p}</p>
        ))
      }
    </div>

    <!-- Photo + quick facts (right on desktop, first on mobile) -->
    <aside
      class="reveal order-1 flex flex-col gap-6 lg:order-2"
      style="--reveal-delay:120ms"
    >
      <div class="relative mx-auto w-full max-w-[18rem]">
        <div
          class="absolute -inset-2 -z-10 rounded-3xl bg-gradient-to-br from-brand-500/20 to-accent-500/20 blur-2xl"
        >
        </div>
        {
          about.photo ? (
            <img
              src={about.photo}
              alt={about.photoAlt}
              width="288"
              height="346"
              loading="lazy"
              decoding="async"
              class="aspect-[5/6] w-full rounded-3xl border border-slate-200 object-cover shadow-xl dark:border-slate-800"
            />
          ) : (
            <div
              class="flex aspect-[5/6] w-full items-center justify-center rounded-3xl border border-slate-200 bg-gradient-to-br from-brand-500 to-accent-500 text-6xl font-extrabold tracking-tight text-white shadow-xl dark:border-slate-800"
              aria-label={about.photoAlt}
            >
              {initials}
            </div>
          )
        }
      </div>

      <dl
        class="mx-auto w-full max-w-[18rem] rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
      >
        {
          about.facts.map((fact, i) => (
            <div
              class={`flex flex-col gap-0.5 ${i > 0 ? "mt-4 border-t border-slate-100 pt-4 dark:border-slate-800" : ""}`}
            >
              <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                {fact.label}
              </dt>
              <dd class="text-sm font-medium text-slate-700 dark:text-slate-200">
                {fact.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>

  <h3
    class="reveal mt-14 text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"
  >
    Skills & Tools
  </h3>

  <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      skillCategories.map((category, i) => (
        <div
          class="reveal rounded-2xl border border-slate-200 bg-white p-5 transition duration-300 hover:-translate-y-1 hover:border-brand-300 hover:shadow-lg hover:shadow-brand-500/10 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-brand-700"
          style={`--reveal-delay:${i * 80}ms`}
        >
          <h4 class="flex items-center gap-2 text-sm font-bold text-slate-900 dark:text-white">
            <span class="h-1.5 w-1.5 rounded-full bg-gradient-to-r from-brand-500 to-accent-500" />
            {category.title}
          </h4>
          <ul class="mt-3 flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <li class="cursor-default rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-sm font-medium text-slate-700 transition hover:-translate-y-0.5 hover:border-brand-400 hover:text-brand-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300 dark:hover:border-brand-500 dark:hover:text-brand-400">
                {skill}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <h3
    class="reveal mt-14 text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400"
  >
    Tech Stack
  </h3>

  <div class="mt-6 grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-7">
    {
      techStack.map((tech, i) => (
        <div
          class="reveal group flex flex-col items-center gap-2 rounded-xl border border-slate-200 bg-white p-4 transition duration-300 hover:-translate-y-1 hover:border-brand-300 hover:shadow-lg hover:shadow-brand-500/10 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-brand-700"
          style={`--reveal-delay:${i * 40}ms`}
        >
          <Icon
            name={tech.icon}
            class="h-8 w-8 transition-transform duration-300 group-hover:scale-110"
            style={tech.color ? `color:${tech.color}` : undefined}
          />
          <span class="text-center text-xs font-medium text-slate-600 dark:text-slate-400">
            {tech.name}
          </span>
        </div>
      ))
    }
  </div>
</section>
